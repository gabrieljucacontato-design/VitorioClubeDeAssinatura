# Copie este arquivo para `.env` no seu ambiente local (não é usado em produção
# na Vercel — lá, configure as mesmas variáveis em Project Settings → Environment Variables).

# Mercado Pago — Suas integrações → Credenciais de produção → Access Token
MP_ACCESS_TOKEN=

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — API Keys
RESEND_API_KEY=
# E-mail que recebe a notificação de cada nova assinatura/compra
OWNER_EMAIL=
# Remetente verificado no Resend (use onboarding@resend.dev para testar sem domínio próprio)
EMAIL_FROM=Vitório <onboarding@resend.dev>

# Painel admin (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# URL pública do site em produção, sem barra no final (ex: https://vitorio.art)
SITE_URL=
